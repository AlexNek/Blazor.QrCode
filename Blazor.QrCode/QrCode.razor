@using Microsoft.JSInterop

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div style="padding: 10px; margin: 10px 0; background-color: #ffebee; border: 1px solid #ef5350; border-radius: 4px; color: #c62828;">
        <strong>⚠️ QR Code Error:</strong> @ErrorMessage
    </div>
}
else
{
    <div id=@CanvasId></div>
}
